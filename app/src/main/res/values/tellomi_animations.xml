  Tellomi（交互审计 A-06 Android）：长按消息的菜单不用窗口进场动画（原来是延迟 150 ms 的淡入），由 ConversationContextMenu
  自己从消息那一侧的上角弹簧展开；退场照上游缩小淡出。
-->
<resources>
    <style name="TellomiConversationContextMenuAnimation" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@null</item>
        <item name="android:windowExitAnimation">@anim/shrink_fade_out</item>
    </style>

    <!-- Tellomi（交互审计 A-11）：TellomiIconSwap 记「交叉淡入结束后换回单张图标」的回调。 -->
    <item name="tellomi_icon_swap_finish" type="id" />
</resources>
