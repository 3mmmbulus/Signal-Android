<?xml version="1.0" encoding="utf-8"?>
<!--
  Tellomi（两端对齐清单 P-5，owner 2026-10-16）：定时消息是一整页（同 TG 两端、iOS），不再是底部弹窗：
  顶上返回 + 标题，中间列表，底下一条输入框（写新的 / 改一条），选时间仍是底部弹层。
-->
<LinearLayout
    xmlns:tools="http://schemas.android.com/tools"
    tools:viewBindingIgnore="true"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tellomi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/signal_colorBackground"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/signal_m3_toolbar_height"
        android:minHeight="@dimen/signal_m3_toolbar_height"
        app:navigationContentDescription="@string/DefaultTopAppBar__navigate_up_content_description"
        app:navigationIcon="@drawable/symbol_arrow_start_24"
        app:titleTextAppearance="@style/Signal.Text.TitleLarge"
        tools:title="@string/TellomiScheduledMessages__title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/video_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/scheduled_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- 空了不关（同 TG 两端：空的定时消息页还在，底下能写新的） -->
        <TextView
            android:id="@+id/tellomi_empty"
            style="@style/Signal.Text.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:textColor="@color/signal_colorOnSurfaceVariant"
            android:visibility="gone" />

        <!-- @ 选人（群里才有），贴着输入框上沿 -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mentions_picker_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <LinearLayout
        android:id="@+id/tellomi_compose_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/signal_colorSurface1"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 改一条时：「编辑消息」+ ✕（同会话输入框改消息） -->
        <LinearLayout
            android:id="@+id/edit_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/symbol_edit_24"
                app:tint="@color/signal_colorOnSurface" />

            <TextView
                android:id="@+id/edit_header_label"
                style="@style/Signal.Text.BodyMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/InputPanel_edit_message"
                android:textColor="@color/signal_colorOnSurface"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/edit_header_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?selectableItemBackgroundBorderless"
                android:contentDescription="@android:string/cancel"
                android:padding="10dp"
                app:srcCompat="@drawable/symbol_x_24"
                app:tint="@color/signal_colorOnSurfaceVariant" />

        </LinearLayout>

        <org.thoughtcrime.securesms.components.LinkPreviewView
            android:id="@+id/link_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:visibility="gone"
            app:linkpreview_type="compose" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <org.thoughtcrime.securesms.components.ComposeText
                android:id="@+id/compose_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/rounded_rectangle_surface_variant_20"
                android:hint="@string/conversation_activity__type_message_push"
                android:imeOptions="flagNoEnterAction"
                android:inputType="textAutoCorrect|textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="@dimen/conversation_compose_height"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:textAppearance="@style/Signal.Text.Body"
                android:textColor="@color/signal_colorOnSurface" />

            <!-- 新写的：日历（点了先选时间，同 TG 定时消息页的发送键）；改的：勾 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/submit_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@color/signal_colorPrimary"
                android:scaleType="centerInside"
                app:contentPadding="12dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Signal.Circle"
                app:srcCompat="@drawable/symbol_calendar_24"
                app:tint="@color/signal_colorOnPrimary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
