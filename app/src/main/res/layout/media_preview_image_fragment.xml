<?xml version="1.0" encoding="utf-8"?>
<org.thoughtcrime.securesms.components.TellomiReleaseObservingFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/media_preview_image_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:viewBindingIgnore="true">

    <org.thoughtcrime.securesms.components.ZoomingImageView
        android:id="@+id/zooming_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:clickable="false"
        android:contentDescription="@string/media_preview_activity__media_content_description" />

    <!-- Tellomi (tellomi/tellomi#1263, spec R-2): a live photo's moving half, over the still -->
    <org.thoughtcrime.securesms.components.TellomiLivePhotoPlayerView
        android:id="@+id/live_photo_video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:visibility="gone" />

</org.thoughtcrime.securesms.components.TellomiReleaseObservingFrameLayout>
