<?xml version="1.0" encoding="utf-8"?>
<!-- Tellomi (spec attachment-files-location L-11): one installed map app in the "Open in" list (its own icon and name). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <ImageView
        android:id="@+id/tellomi_location_app_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tellomi_location_app_label"
        style="@style/Signal.Text.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/signal_colorOnSurface"
        tools:text="Amap" />
</LinearLayout>
